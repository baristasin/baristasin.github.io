---
// The photo band at the top of the home page, adapted from the Astro Chalet theme's
// immersive hero (MIT, see LICENSES/astro-chalet.txt).
// It is kept short on purpose, so the About section already shows on the first screen.
import { Image } from 'astro:assets';
import heroPhoto from '../assets/home/hero.jpg';
import { hero } from '../site.config';
---

<div class="hero">
  <Image
    class="hero-photo"
    src={heroPhoto}
    alt=""
    widths={[960, 1600, 2400]}
    sizes="(max-width: 760px) 200vw, 100vw"
    style={`object-position: ${hero.photoPosition}`}
    priority
  />
  <div class="container hero-stage">
    {hero.quote && (
      <figure class="hero-quote">
        <blockquote>“{hero.quote}”</blockquote>
        {hero.quoteAuthor && <figcaption>{hero.quoteAuthor}</figcaption>}
      </figure>
    )}
    {hero.photoCaption && <p class="hero-caption">{hero.photoCaption}</p>}
  </div>
  <svg class="hero-ridge" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 70V38L180 12l150 22 190-30 170 26 160-14 210 22 180-28 200 24V70z"></path>
  </svg>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Short on purpose: the About section must show on the first screen. */
    min-height: clamp(300px, 54vh, 600px);
    min-height: clamp(300px, 54svh, 600px);
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* With a quote, the lower left darkens so the text stays readable. */
  .hero:has(.hero-quote)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(15deg, rgba(29, 20, 13, 0.78) 0%, rgba(29, 20, 13, 0.35) 45%, transparent 75%);
  }

  .hero-stage {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-4) var(--space-2);
  }

  .hero-quote {
    margin: 0;
    max-width: 38rem;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.35);
  }

  .hero-quote blockquote {
    margin: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.35rem, 2.8vw, 2.2rem);
    line-height: 1.3;
    text-wrap: balance;
  }

  .hero-quote figcaption {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-bright);
  }

  .hero-quote figcaption::before {
    content: '— ';
  }

  .hero-caption {
    margin: 0 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-dark-text);
    opacity: 0.85;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  /* Mountain-ridge edge into the About section */
  .hero-ridge {
    display: block;
    width: 100%;
    height: clamp(32px, 5vw, 70px);
    margin-top: -1px;
  }

  .hero-ridge path {
    fill: var(--color-surface);
  }

  /* Phones: a lower band, so the name and the first lines of About fit on the first screen. */
  @media (max-width: 760px) {
    .hero {
      min-height: clamp(240px, 44vh, 400px);
      min-height: clamp(240px, 44svh, 400px);
    }
  }
</style>
