---
// The About section, right under the photo band. Adapted from the Astro Chalet theme
// (MIT, see LICENSES/astro-chalet.txt).
// Text: src/content/about.md · Portrait: src/assets/home/portrait.jpg
import { Image } from 'astro:assets';
import portrait from '../assets/home/portrait.jpg';
import { Content as AboutText } from '../content/about.md';
import { site, profileLinks } from '../site.config';
---

<section class="about section-alt" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <header class="about-head">
      <p class="section-eyebrow">About me</p>
      <h1 id="about-title">{site.name}</h1>
      <p class="lede">{site.tagline}</p>
      <p class="now"><span class="now-pill">Now</span><span>{site.now}</span></p>
    </header>

    <figure class="about-figure">
      <Image class="about-portrait" src={portrait} alt={site.name} widths={[340, 680]} sizes="340px" loading="eager" />
    </figure>

    <div class="about-body">
      <AboutText />
      <p class="about-actions">
        <a class="button" href="#work">See my work <span aria-hidden="true">↓</span></a>
        {profileLinks.map((link) => (
          <a class="button button-secondary" href={link.url} target="_blank" rel="noopener">{link.label}</a>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    /* Tight at the top, so the section starts right under the photo. */
    padding-block: var(--space-3) var(--space-section);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(220px, 340px) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'figure head'
      'figure body';
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: var(--space-3);
    align-items: start;
  }

  .about-head {
    grid-area: head;
  }

  .about-head h1 {
    margin-bottom: var(--space-1);
  }

  .about-head .lede {
    margin-bottom: var(--space-2);
  }

  .now {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .now-pill {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 1px 9px;
  }

  .about-figure {
    grid-area: figure;
    position: relative;
    isolation: isolate;
    margin: 16px 0 0 16px;
  }

  .about-portrait {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lift);
  }

  /* Decorative offset shapes behind the portrait */
  .about-figure::before {
    content: '';
    position: absolute;
    inset: -16px auto auto -16px;
    width: 110px;
    height: 110px;
    border-radius: var(--radius);
    background: var(--gradient-accent);
    opacity: 0.16;
    z-index: -1;
  }

  .about-figure::after {
    content: '';
    position: absolute;
    inset: auto -16px -16px auto;
    width: 150px;
    height: 150px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    z-index: -1;
  }

  .about-body {
    grid-area: body;
  }

  /* Editorial drop cap on the first paragraph */
  .about-body :global(p:first-of-type::first-letter) {
    font-family: var(--font-heading);
    font-size: 3.2em;
    float: left;
    line-height: 0.82;
    padding-right: 0.12em;
    color: var(--color-accent);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas:
        'head'
        'figure'
        'body';
    }

    .about-figure {
      width: min(100% - 16px, 280px);
    }
  }
</style>
