---
import type { CollectionEntry } from 'astro:content';

interface Props {
  levels: { entry: CollectionEntry<'career'>; color: string }[];
  chapters: { number: number; mapLabel: string }[];
}

const { levels, chapters } = Astro.props;
---

<aside class="minimap" aria-label="Career map">
  <div class="map-head">
    <p class="map-title">World map</p>
    <p class="map-count mono">{levels.length} levels · {chapters.length} chapters</p>
  </div>

  <ol class="path">
    <li class="path-label is-now">Now</li>
    {chapters.map((chapter) => (
      <>
        <li class="chapter-mark">Ch. {chapter.number} · {chapter.mapLabel}</li>
        {levels
          .filter(({ entry }) => entry.data.chapter === chapter.number)
          .map(({ entry, color }) => (
            <li>
              <a class="node" href={`#${entry.id}`} data-target={entry.id} style={`--c: ${color}`}>
                <span class="joint"></span>
                <span class="node-name">{entry.data.mapName ?? entry.data.title}</span>
                <span class="node-year">{entry.data.years ?? ''}</span>
              </a>
            </li>
          ))}
      </>
    ))}
    <li class="path-label">Start</li>
  </ol>

  <div class="legend">
    <div class="legend-bar"></div>
    <div class="legend-scale"><span>Earlier</span><span>Recent</span></div>
    <p class="legend-note">Colors work like a depth camera. Warm levels are recent, cool ones came earlier.</p>
  </div>
</aside>
