---
// A short photo band between the About section and the career map.
// Its bottom edge is the same mountain ridge as the top photo (--ridge-bottom in tokens.css).
// To use your own photo, replace src/assets/home/band.jpg and keep the file name.
import { Image } from 'astro:assets';
import bandPhoto from '../assets/home/band.jpg';
import { band } from '../site.config';
---

<div class="photo-band">
  <Image
    class="band-photo"
    src={bandPhoto}
    alt=""
    widths={[960, 1600, 2400]}
    sizes="(max-width: 760px) 200vw, 100vw"
    style={`object-position: ${band.photoPosition}`}
  />
  {band.photoCaption && <p class="band-caption">{band.photoCaption}</p>}
</div>

<style>
  .photo-band {
    position: relative;
    height: clamp(180px, 22vw, 300px);
    overflow: hidden;
    /* Shows through the ridge cut at the bottom of the photo, so it matches the dark career map */
    background: var(--night-bg);
  }

  .band-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: var(--ridge-bottom);
  }

  .band-caption {
    position: absolute;
    right: var(--space-3);
    bottom: calc(var(--ridge-height) + var(--space-1));
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-dark-text);
    opacity: 0.85;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }
</style>
