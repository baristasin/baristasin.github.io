---
// Dark sticky header, adapted from the Astro Chalet theme (MIT, see LICENSES/astro-chalet.txt).
// "Work" is always the main button. The other tabs stay small, and on phones they fold into a menu.
import { getCollection } from 'astro:content';
import { site, moreTabs } from '../site.config';

// While you work locally every tab shows. On the live site a writing tab
// appears only once its section has a published entry.
const visibleTabs = [];
for (const tab of moreTabs) {
  if (!tab.collection || import.meta.env.DEV) {
    visibleTabs.push(tab);
    continue;
  }
  const publishedEntries = await getCollection(tab.collection, ({ data }) => !data.draft);
  if (publishedEntries.length > 0) visibleTabs.push(tab);
}

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">{site.name}</a>

    <nav class="site-nav" aria-label="Main">
      {visibleTabs.length > 0 && (
        <ul class="tabs" id="more-tabs">
          {visibleTabs.map((tab) => (
            <li>
              <a href={tab.href} aria-current={currentPath.startsWith(tab.href) ? 'page' : undefined}>
                {tab.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <a class="work-link" href="/#work">Work</a>
      {visibleTabs.length > 0 && (
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="more-tabs" aria-label="More pages">
          <span></span><span></span><span></span>
        </button>
      )}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-dark-bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(247, 240, 228, 0.12);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-height);
  }

  .brand {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 650;
    color: var(--color-dark-text);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .brand:hover {
    color: var(--color-accent-bright);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .tabs {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tabs a {
    color: var(--color-dark-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .tabs a:hover,
  .tabs a[aria-current='page'] {
    color: var(--color-dark-text);
  }

  .work-link {
    background: var(--color-accent-bright);
    color: var(--color-dark-bg);
    border-radius: var(--radius-pill);
    padding: 0.45rem 1.2rem;
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background-color var(--transition);
  }

  .work-link:hover {
    background: var(--color-dark-text);
    color: var(--color-dark-bg);
  }

  .menu-button {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    padding: var(--space-1);
    cursor: pointer;
  }

  .menu-button span {
    width: 22px;
    height: 2px;
    background: var(--color-dark-text);
    border-radius: 2px;
  }

  @media (max-width: 820px) {
    .site-nav {
      gap: var(--space-1);
    }

    .menu-button {
      display: flex;
    }

    .tabs {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--color-dark-bg);
      border-bottom: 1px solid rgba(247, 240, 228, 0.12);
    }

    .tabs.is-open {
      display: flex;
    }

    .tabs a {
      display: block;
      padding: var(--space-2) var(--space-3);
      border-top: 1px solid rgba(247, 240, 228, 0.12);
      font-size: var(--text-base);
    }
  }
</style>

<script>
  // On phones the small tabs open from the menu button.
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
  const moreTabs = document.querySelector<HTMLElement>('#more-tabs');

  menuButton?.addEventListener('click', () => {
    const isOpen = moreTabs?.classList.toggle('is-open') ?? false;
    menuButton.setAttribute('aria-expanded', String(isOpen));
  });
</script>
