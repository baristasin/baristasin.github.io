---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('reading', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout entry={entry} sectionLabel="Reading Journal" sectionHref="/reading/">
  <Content />
</PostLayout>
