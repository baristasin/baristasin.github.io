---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import AboutMe from '../components/AboutMe.astro';
import CareerMap from '../components/CareerMap.astro';
import LevelCard from '../components/LevelCard.astro';
import LevelDetails from '../components/LevelDetails.astro';
import { chapters } from '../site.config';

// Newest level first.
const careerEntries = (await getCollection('career')).sort((a, b) => b.data.level - a.data.level);

// Older levels get cool colors, recent ones warm colors (--d0 … --d8 in tokens.css).
const highestLevel = Math.max(...careerEntries.map((entry) => entry.data.level));
function getDepthColor(level: number) {
  const depthIndex = Math.round(((level - 1) / Math.max(1, highestLevel - 1)) * 8);
  return `var(--d${depthIndex})`;
}

const levels = careerEntries.map((entry) => ({ entry, color: getDepthColor(entry.data.level) }));
---

<BaseLayout>
  <HomeHero />
  <AboutMe />

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container is-wide">
      <header class="work-head">
        <p class="section-eyebrow">Portfolio</p>
        <h2 id="work-title">Career map</h2>
        <p class="lede">{levels.length} levels in {chapters.length} chapters, newest first. Pick a level to see its details.</p>
      </header>

      <div class="world">
        <CareerMap levels={levels} chapters={chapters} />

        <div class="levels">
          {chapters.map((chapter) => (
            <section class="chapter" aria-labelledby={`chapter-${chapter.number}`}>
              <header class="chapter-head">
                <p class="mono">Chapter {chapter.number} · {chapter.meta}</p>
                <h3 id={`chapter-${chapter.number}`}>{chapter.title}</h3>
              </header>
              {levels
                .filter(({ entry }) => entry.data.chapter === chapter.number)
                .map(({ entry, color }) => <LevelCard entry={entry} color={color} />)}
            </section>
          ))}
        </div>

        <div class="details-column">
          <LevelDetails levels={levels} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
